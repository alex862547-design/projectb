# คัดลอกไฟล์นี้เป็นชื่อ .env
# (ถ้ามี .env อยู่แล้ว แค่เพิ่มบรรทัด JWT_SECRET เข้าไปเพิ่ม ไม่ต้องสร้างใหม่ทั้งไฟล์)

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sports_day
PORT=4000

# ตั้งเป็นข้อความอะไรก็ได้ ยาวๆ สุ่มๆ ใช้สำหรับเข้ารหัส token ล็อกอิน
# ห้ามบอกใคร และห้ามใช้ค่าเดียวกับที่อื่น
JWT_SECRET=change_this_to_a_long_random_string_1234567890
